# TeleFridge V1 — secrets template.
# Copy this file to secrets.yaml (which is gitignored) and fill in real values.
# NEVER commit the real secrets.yaml.

wifi_ssid: "your-wifi-ssid"
wifi_ssid_2: "your-second-wifi-ssid"   # fallback network (config tries both)
wifi_password: "your-wifi-password"    # same password used for both networks

# Telegram Bot API — create a bot with @BotFather to get the token,
# and get your chat id (e.g. via @userinfobot or the getUpdates endpoint).
telegram_bot_token: "123456789:AA...your-bot-token..."
telegram_chat_id: "-1001234567890"

# OTA update password — generate with: openssl rand -hex 16
ota_password: "your-ota-password"
